      "text": "L1P = dict(a2=3.60, a3p=22.55, a3n=19.17, L=15.47)\nL1CAL = np.clip(np.array([0.91,0.99,1.19,1.0,1.10,0.5,1.04,0.92,0.90,0.70,0.69,1.40,1.09]), 0.5, 1.5)\ndef l1_alpha(seq):\n    U = np.array(seq, dtype=float)\n    u3p = np.clip(U[:,2],0,None); u3n = np.clip(-U[:,2],0,None)\n    V = np.stack([U[:,0], L1P['a2']*U[:,1], L1P['a3p']*u3p - L1P['a3n']*u3n], axis=1)\n    return float(np.exp(-np.linalg.norm(V.sum(axis=0)) / L1P['L']))\ndef predict_L1(t_a, seq):\n    k = len(seq); t_read = t_a + 5.0*k\n    rec = rec_interp(0, t_read)\n    m_loc, v_loc = local_stats(0, t_read)\n    a = l1_alpha(seq)\n    mean = a*rec + (1-a)*m_loc[:,None]\n    var = (1 - a*a) * v_loc[:,None] * np.ones((13,13))\n    sigma = np.sqrt(var + np.maximum(INTERP[0][:,None], 5e-4)**2) * L1CAL[:,None]\n    return mean, np.maximum(sigma, 1e-4)"
