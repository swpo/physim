      "text": "def emis_M(inj, amp, dur, lag):\n    \"\"\"M[13] magnitude and spread[13] across measurements\"\"\"\n    eff = _eff(amp, dur)\n    li = _nearest_lag(lag)\n    pts = MEAS.get(inj, {}).get(li, [])\n    if pts:\n        arr_a = np.array([p[0] for p in pts]); arr_m = np.array([p[1] for p in pts])  # [n,13]\n        # weight by closeness in eff-amp\n        w = np.exp(-((arr_a - min(eff, arr_a.max()))**2) / (2*0.2**2)) + 1e-6\n        M = (w[:,None]*arr_m).sum(0)/w.sum()\n        spread = np.sqrt(np.maximum(((w[:,None]*(arr_m - M)**2).sum(0)/w.sum()), 0.0))\n        if eff > arr_a.max():\n            M = M * min(1.0 + 0.35*(eff - arr_a.max()), 1.7)\n            spread = np.maximum(spread, 0.5*M)\n        return M, spread\n    # no measurements for this inj port: scale its amp-1 template or fall back to tiny\n    base_pts = MEAS.get(inj, {})\n    allm = [m for lps in base_pts.values() for a,m in lps if abs(a-1.0) < 0.05]\n    if allm:\n        Mb = np.mean(allm, axis=0)\n    else:\n        Mb = np.full(13, 0.01)\n    M = Mb * amp_ratio(eff)\n    return M, 0.5*M\ndef _predict_L4_generic(t_a, port, amp, dur, lags):\n    means, sigs = [], []\n    for lag in lags:\n        t = t_a + lag\n        rec = rec_interp(1, t)\n        M, spread = emis_M(port, amp, dur, lag)\n        m_loc, v_loc = local_stats(1, t)\n        v = np.maximum(v_loc, 1e-8)\n        alpha = np.clip(1 - (M**2)/(2*v), 0.0, 1.0)\n        mean = alpha[:,None]*rec + (1-alpha)[:,None]*m_loc[:,None]\n        var = (1 - alpha**2)[:,None]*v[:,None]\n        extra = (0.7*M + spread)**2   # anchor/template variability\n        sig = np.sqrt(var + np.minimum(extra, v)[:,None] + INTERP[1][:,None]**2 + 0.002**2)\n        # cap sigma at ~1.2x climatological sd (no point exceeding)\n        cap = 1.2*np.sqrt(v)[:,None] + 0.01\n        sig = np.minimum(sig, np.maximum(cap, 0.01))\n        sig = np.broadcast_to(sig, (13, NS[1])).copy()\n        means.append(mean); sigs.append(np.maximum(sig, 1e-4))\n    return np.array(means), np.array(sigs)\ndef predict_L4(t_a, port, amp, dur):\n    return _predict_L4_generic(t_a, port, amp, dur, (10.,25.,50.,100.,175.,250.))\ndef predict_L4D(t_a, port, amp, dur):\n    return _predict_L4_generic(t_a, port, amp, dur, (25.,75.,150.))"
