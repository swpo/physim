      "text": "# ---------- global stream ----------\ndef _load_globals():\n    pts = {}\n    def unwrap(s):\n        d = json.loads(s)\n        return json.loads(d['result']) if isinstance(d.get('result'), str) else d\n    for f in glob.glob('/app/data/globals/*.jsonl'):\n        for line in open(f):\n            if not line.strip(): continue\n            try: d = unwrap(line)\n            except Exception: continue\n            if 't' in d and 'global_stats' in d:\n                pts[d['t']] = np.array(d['global_stats'])\n    for f in glob.glob('/app/data/base/chunk_*.json') + glob.glob('/app/data/forks/*_c*.json'):\n        try: d = unwrap(open(f).read())\n        except Exception: continue\n        if d.get('steps') and d.get('global_stats'):\n            pts[d['steps'][-1]['t']] = np.array(d['global_stats'])\n    ts = np.array(sorted(pts)); G = np.array([pts[t] for t in ts])\n    return ts, G\nGTS, G = _load_globals()\ndef glob_interp(t):\n    t = float(np.clip(t, GTS[0], GTS[-1]))\n    i = int(np.clip(np.searchsorted(GTS, t), 1, len(GTS)-1))\n    w = (t - GTS[i-1]) / (GTS[i] - GTS[i-1])\n    return (1-w)*G[i-1] + w*G[i]\ndef glob_gap(t):\n    t = float(np.clip(t, GTS[0], GTS[-1]))\n    i = int(np.clip(np.searchsorted(GTS, t), 1, len(GTS)-1))\n    return float(GTS[i] - GTS[i-1])\ndef glob_window_avg(t_end, width=200.0, n=41):\n    return np.mean([glob_interp(t) for t in np.linspace(t_end-width, t_end, n)], axis=0)"
    },
