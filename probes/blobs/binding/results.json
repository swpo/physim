{
 "program": "BLOBS M2 blob-binding",
 "conventions": {
  "integrator": "explicit Euler, 5-pt periodic Laplacian, dt=min(0.2*dx^2/Dw, 0.02)",
  "seeding": "stamp method: relax single blob 2000tu on L=64 -> save (du,dv,dw) deviation stamp -> paste at positions",
  "threshold": "thr = u0 + 0.45*(sqrt(lam)-u0)",
  "tracking": "periodic connected components + circular-mean centroids",
  "units": "1 px = 1 space unit at dx=1; tu = time units"
 },
