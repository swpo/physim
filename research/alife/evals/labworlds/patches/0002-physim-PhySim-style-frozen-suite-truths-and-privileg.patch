+            f"{S[c][k]['joint_energy_equal_group_mean'] / r:.2f}" for k in controls if k != ref) + " |")
+    lines += ["", f"Simulation CPU recorded in cached ensembles: {member_cpu / 3600:.2f} h."]
+    (out / "report.md").write_text("\n".join(lines) + "\n")
