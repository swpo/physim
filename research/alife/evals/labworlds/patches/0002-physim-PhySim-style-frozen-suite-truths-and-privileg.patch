+            continue
+        lines.append(f"| {k} | " + " | ".join(f"{summary['groups'][k][g]['ratio']:.2f}" for g in gids) + " |")
+    lines += ["", "Per case: aggregate ratio to independent_native.", "",
+              "| case | program | " + " | ".join(k for k in controls if k != ref) + " |",
+              "|---" * (len(controls) + 1) + "|"]
+    for c in scored:
