+def band(spec: LabSpec, out: Path, members: int = 8):
+    """Native-vs-native noise band: a second independent native ensemble per case (seeds 91000 + i),
+    scored against the same frozen truths and groups. Diagnostic only; the frozen suite is untouched."""
+    suite = json.loads((out / "suite.json").read_text())
+    groups, rost = suite["groups"], roster(spec)
+    native = make_oracle(spec, "native")
+    (out / "band").mkdir(exist_ok=True)
+    rows = []
+    for i, entry in enumerate(suite["cases"]):
+        case = entry["request"]
+        sp = out / "controls" / case["id"] / "scores.json"
+        if not sp.exists():
+            continue
+        truth = cached(out / entry["truth"], None, meta=dict(request=case, members=N_TRUTH, seed=TRUTH_SEED + i))
+        pred = cached(out / "band" / f"{case['id']}.npz", lambda: native.sample_truth(
+            case["actions"], case["queries"], members, truth_seed=BAND_SEED + i),
+            meta=dict(request=case, members=members, seed=BAND_SEED + i, variant="native"))
+        b = scoring.score_case(case, {"samples": pred}, {"samples": truth}, groups=groups,
+                               n_samples=members, n_truth=N_TRUTH, roster=rost)
+        s = json.loads(sp.read_text())
+        rows.append(dict(case=case["id"], family=entry["family"], native=s["independent_native"],
+                         native_b=b, null=s.get("numerical_null")))
+    agg = lambda r, k: r[k]["joint_energy_equal_group_mean"]
+    nat = np.array([agg(r, "native") for r in rows])
+    nb = np.array([agg(r, "native_b") for r in rows])
+    nul = np.array([agg(r, "null") for r in rows])
+    pooled = 0.5 * (nat + nb)
+    gids = [g["id"] for g in groups]
+    gs = lambda r, k, g: next(x["energy_score"] for x in r[k]["joint_energy"] if x["id"] == g)
+    res = dict(world=spec.name, n_cases=len(rows), seed_base=BAND_SEED, members=members,
+               native_b_over_native=dict(ratio=float(nb.mean() / nat.mean()), ci90=_boot(nb, nat),
+                                         per_case=(nb / nat).round(3).tolist()),
+               null_over_native=dict(ratio=float(nul.mean() / nat.mean()), ci90=_boot(nul, nat)),
+               null_over_pooled_native=dict(ratio=float(nul.mean() / pooled.mean()), ci90=_boot(nul, pooled)),
+               groups={g: dict(native_b_over_native=float(np.mean([gs(r, "native_b", g) for r in rows]) /
+                                                          np.mean([gs(r, "native", g) for r in rows])),
+                               null_over_pooled=float(np.mean([gs(r, "null", g) for r in rows]) /
+                                                      np.mean([0.5 * (gs(r, "native", g) + gs(r, "native_b", g))
+                                                               for r in rows])))
+                       for g in gids})
+    (out / "band.json").write_text(json.dumps(res, indent=1) + "\n")
+    print(json.dumps({k: v for k, v in res.items() if k != "groups"}, indent=1))
+    return res
