+"""Item 3 pilots: zero-noise single members of each program (native) and of the matching ablations on chosen
+programs, with readouts at the suite's 15 times and full fields at 0/10/20/30/40/50 tu (float16, for pictures).
+
+  pilot.py pm|cips [variant:program ...]   (default: every program native + the planned ablation pairs)
+"""
+import json, sys, time, dataclasses
+from pathlib import Path
+sys.path.insert(0, "/home/user/evalwork/pm_cips_eval/scripts")
+from common import PC, E, LW, EVALPILOT, OUT
+import numpy as np
+
+world_name = sys.argv[1]
+D = Path(OUT) / "pilot" / world_name
+D.mkdir(parents=True, exist_ok=True)
+SNAP = [0, 10, 20, 30, 40, 50]
+
+
+def pm_setup():
+    st = PC.load_state(f"{EVALPILOT}/out/prep_s0.npz", PC.PM_FIELDS)
+    info = json.load(open(f"{EVALPILOT}/out/prep_s0.json"))
+    devs = [PC.device(0, info["sites"]["centre"], 128), PC.device(1, info["sites"]["other"], 128)]
+    w = PC.pm_world(0.0, 0.5, ell=None, actuators=PC.PM_ACTUATORS)
+    abl = {"a2": {"a": 2.0}, "chi0": {"chi": 0.0}, "feed10": {"F": 0.06}, "feed3": {"F": 0.02}, "DS2": {"DS": 0.4}}
+    pairs = [("a2", p) for p in ("sham", "K_d0", "L_d0", "L_rim")] + [("chi0", p) for p in ("sham", "L_d0", "L_rim")] \
+        + [("feed10", p) for p in ("sham", "Sm_d0", "Sm_d1", "Sp_d1")]
+    return st, devs, w, abl, dict((p[0], p[1]) for p in PC.pm_programs()), pairs
+
+
+CIPS_SITES = {"device0": [20.2, 153.8], "device1": [16.1, 101.8]}
+
+
+def cips_setup():
+    st = PC.load_state(f"{OUT}/cips_prep/prep_s5_t3100.npz", PC.CIPS_FIELDS)
+    devs = [PC.device(0, CIPS_SITES["device0"], 192), PC.device(1, CIPS_SITES["device1"], 192)]
+    w = PC.cips_world(0.0, ell=None, gains={"p": 0.3, "F": 0.3, "s": 1.0}, actuators=PC.CIPS_ACTUATORS)
+    abl = {"chi0": {"chi": 0.0}, "kF0": {"kF": 0.0}, "chis0": {"chi_s": 0.0}, "d0": {"d": 0.0}, "DF10": {"DF": 20.0}}
+    pairs = [("chi0", p) for p in ("sham", "p_d0", "p_d1")] + [("kF0", p) for p in ("sham", "Fp_d0")] \
+        + [("chis0", p) for p in ("sham", "s_d0")] + [("d0", p) for p in ("sham",)] + [("DF10", p) for p in ("sham", "Fm_d0", "Fm_d1")]
+    return st, devs, w, abl, dict((p[0], p[1]) for p in PC.cips_programs()), pairs
+
+
+st, devs, w, abl, progs, pairs = (pm_setup if world_name == "pm" else cips_setup)()
+todo = [a.split(":") for a in sys.argv[2:]] or ([("native", p) for p in progs] + pairs)
+for variant, prog in todo:
+    path = D / f"{variant}__{prog}.npz"
+    if path.exists():
+        continue
+    wv = w if variant == "native" else PC.replace(w, overrides={**w.overrides, **abl[variant]})
+    o = LW.oracle(wv, st, devs)
+    PC.one_worker(o._stepper.module)
+    snaps = {}
+    orig = o._fill_queries
+
+    def fill(live, devices, marks, output, member, _orig=orig):
+        t = round(live["t_step"] * 0.02, 6)
+        if t in SNAP:
+            snaps[f"F_{int(t)}"] = np.asarray(live["F"], dtype=np.float16)
+            snaps[f"c0_{int(t)}"] = np.asarray(devices[0].center); snaps[f"c1_{int(t)}"] = np.asarray(devices[1].center)
+        return _orig(live, devices, marks, output, member)
+    o._fill_queries = fill
+    q = [dict(sensor=s, t=sorted(set(E.TIMES) | set(SNAP))) for s in E.SENSORS]
+    t0 = time.process_time()
+    res = o.sample_truth(progs[prog], q, 1, truth_seed=1)["samples"]
+    cpu = time.process_time() - t0
+    F = np.stack([np.asarray(r) for r in res[:2]]) if False else None
+    np.savez_compressed(path, cpu_s=cpu, times=np.array(q[0]["t"]), d0=res[0][0], d1=res[1][0], gl=res[2][0],
+                        **snaps)
+    fin = all(np.isfinite(r).all() for r in res)
+    rng_ = {f: [float(res[2][0][:, i, 0].min()), float(res[2][0][:, i, 0].max())] for i, f in enumerate(w.fields)}
+    print(f"{variant}:{prog} cpu {cpu:.1f}s finite {fin}", flush=True)
diff --git a/scripts/physim/labworlds/pmcips_runs/pilot_analyse.py b/scripts/physim/labworlds/pmcips_runs/pilot_analyse.py
new file mode 100644
index 0000000..2166fd3
--- /dev/null
+++ b/scripts/physim/labworlds/pmcips_runs/pilot_analyse.py
@@ -0,0 +1,74 @@
+"""Pilot readouts: what each program changes at the probes (native, zero noise) and how each ablation's response
+to its program differs from the native response. Units: native member spread at noise (per sensor and field:
+RMS over nodes and the 13 score times of the across-member sd of a noisy native ensemble on the sham program).
+
+  visibility(prog)           = RMS_{nodes,t}((nat_prog - nat_sham) / spread)
+  ablation_total(abl, prog)  = RMS((abl_prog - nat_prog) / spread)
+  response_diff(abl, prog)   = RMS(((abl_prog - abl_sham) - (nat_prog - nat_sham)) / spread)   (program-specific part)
+"""
+import sys, json, glob, os
+import numpy as np
+OUT = "/home/user/evalwork/pm_cips_eval"
+world = sys.argv[1]
+spread_file = sys.argv[2]          # npz with q0,q1,q2 member arrays (members, times, ports, slots) on sham, TIMES
+TIMES = [0, 2, 5, 8, 10, 12, 15, 20, 22, 25, 30, 35, 40, 45, 50]
+SCORE = [2, 5, 8, 10, 12, 15, 20, 25, 30, 35, 40, 45, 50]
+fields = ("S", "K", "L", "phi") if world == "pm" else ("e", "p", "F", "s")
+z = np.load(spread_file)
+qs = [z[k] for k in sorted(k for k in z.files if k.startswith("query"))] if "query0" in z.files else \
+    [np.stack([z[f"m{m}_q{q}"] for m in range(2)]) for q in range(3)]
+ti = [TIMES.index(t) for t in SCORE] if "query0" in z.files else [k for k in range(1, 11)]   # cips noise runs: every 5 tu
+if "query0" not in z.files:
+    qs = [q[:, 0] for q in qs]          # (members, times, ports, slots)
+spread = {}
+for qi, s in enumerate(("d0", "d1", "gl")):
+    a = qs[qi][:, ti]
+    sd = a.std(axis=0, ddof=1)                     # (times, ports, slots)
+    for p, f in enumerate(fields):
+        spread[(s, f)] = float(np.sqrt((sd[:, p, :] ** 2).mean())) + 1e-12
+D = f"{OUT}/pilot/{world}"
+runs = {os.path.basename(p)[:-4]: np.load(p) for p in sorted(glob.glob(f"{D}/*.npz"))}
+
+
+def readout(r, s):
+    times = list(r["times"])
+    idx = [times.index(t) for t in SCORE]
+    return r[s][idx]
+
+
+def rms(diff, s, f, p):
+    return float(np.sqrt(((diff[:, p, :] / spread[(s, f)]) ** 2).mean()))
+
+
+res = {"spread": {f"{s}/{f}": v for (s, f), v in spread.items()}, "visibility": {}, "ablation": {}}
+nat_sham = runs["native__sham"]
+for k, r in runs.items():
+    v, prog = k.split("__")
+    if v != "native" or prog == "sham":
+        continue
+    res["visibility"][prog] = {s: {f: round(rms(readout(r, s) - readout(nat_sham, s), s, f, p), 2) for p, f in enumerate(fields)}
+                               for s in ("d0", "d1", "gl")}
+for k, r in runs.items():
+    v, prog = k.split("__")
+    if v == "native":
+        continue
+    nat = runs[f"native__{prog}"]
+    ab_sham = runs.get(f"{v}__sham")
+    e = {}
+    for s in ("d0", "d1", "gl"):
+        e[s] = {}
+        for p, f in enumerate(fields):
+            tot = rms(readout(r, s) - readout(nat, s), s, f, p)
+            spec = None
+            if ab_sham is not None and prog != "sham":
+                spec = rms((readout(r, s) - readout(ab_sham, s)) - (readout(nat, s) - readout(nat_sham, s)), s, f, p)
+            e[s][f] = [round(tot, 2), None if spec is None else round(spec, 2)]
+    res["ablation"][k] = e
+json.dump(res, open(f"{D}/analysis.json", "w"), indent=1)
+print("spread", {k: round(v, 4) for k, v in res["spread"].items()})
+print("\nvisibility vs sham (native): per sensor, per field")
+for prog, v in res["visibility"].items():
+    print(f"{prog:18s}", " | ".join(f"{s}: " + " ".join(f"{x:6.1f}" for x in v[s].values()) for s in v))
+print("\nablation: [total vs native on the same program, program-specific response difference]")
+for k, e in res["ablation"].items():
+    print(f"{k:22s}", " | ".join(f"{s}: " + " ".join(f"{x[0]:.1f}/{x[1] if x[1] is not None else '-'}" for x in e[s].values()) for s in e))
