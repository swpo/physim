+    base, genome = native_runner(args.seed)
+    n = len(base._perm)
+    rows["world"] = dict(genome=genome.get("id", "bf"), n_ports=n, grid=list(base._template["F"].shape))
+    actions, queries = rich_request(n, args.horizon)
+    runners = {
+        "OracleRunner": base,
