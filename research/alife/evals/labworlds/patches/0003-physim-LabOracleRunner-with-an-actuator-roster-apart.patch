+            _devices=base._devices,
+            _port_perm=[2, 0, 3, 1],
+            _adjust_mix=MIX,
+            _stepper=step_chunk,
+        ),
+    }
+    out, secs = {}, {}
+    for name, r in runners.items():
+        c0 = cpu()
+        out[name] = r.sample_truth(actions, queries, args.members, truth_seed=11)["samples"]
+        secs[name] = round(cpu() - c0, 1)
+    ref = out["OracleRunner"]
+    rows["rich_permuted"] = dict(
