{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swpo.github.io/physim/schemas/world-bundle-v1.schema.json",
  "title": "Physim world bundle v1 manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "status",
    "licenses",
    "objects",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "physim-world-bundle-v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^bundle:sha256:[0-9a-f]{64}$"
    },
    "status": {
      "type": "string"
    },
    "licenses": {
      "type": "object",
      "required": [
        "code",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "objects": {
      "type": "object",
      "required": [
        "world",
        "preparation",
        "suite"
      ],
      "additionalProperties": false,
      "properties": {
        "world": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^world:sha256:[0-9a-f]{64}$"
            }
          }
        },
        "preparation": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^preparation:sha256:[0-9a-f]{64}$"
            }
          }
        },
        "suite": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^suite:sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "role",
          "profiles"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "simulation",
                "evaluation"
              ]
            }
          }
        }
      }
    }
  },
  "$comment": "Use physim.bundles for authoritative identity, path, aggregate byte, cross-file, physical, and array validation."
}
